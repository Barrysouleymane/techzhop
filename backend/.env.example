# "production" when online (hides error details, requires https sites)
NODE_ENV=development
PORT=

# Website address(es), comma-separated — e.g. https://techzhop.com,https://www.techzhop.com
FRONTEND_URL=

STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=

SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Shop owners (always admin), comma-separated
ADMIN_EMAILS=

# Emails (https://resend.com — free 3,000/month)
RESEND_API_KEY=
EMAIL_FROM=TechZhop <onboarding@resend.dev>
# Language of the "new order" emails sent to you (en, fr, es, pt, de, zh)
ADMIN_EMAIL_LANGUAGE=fr

# Days a customer has to ask for a return after delivery
RETURN_DAYS=14
