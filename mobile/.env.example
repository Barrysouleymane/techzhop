# Same values as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the web .env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Your Mac's local IP (not localhost) so the phone can reach the backend, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=
# Website address (used for the "forgot password" email link)
EXPO_PUBLIC_WEB_URL=
# Support contact shown on the Help screen
EXPO_PUBLIC_SUPPORT_EMAIL=
# WhatsApp number, international format without + or spaces (e.g. 224620000000)
EXPO_PUBLIC_SUPPORT_WHATSAPP=
