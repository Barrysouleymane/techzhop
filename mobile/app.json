{
  "expo": {
    "name": "TechZhop",
    "slug": "techzhop",
    "scheme": "techzhop",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.techzhop.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr",
          "es",
          "pt",
          "de",
          "zh"
        ]
      }
    },
    "android": {
      "package": "com.techzhop.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "TechZhop uses your photos to set your profile picture."
        }
      ]
    ]
  }
}